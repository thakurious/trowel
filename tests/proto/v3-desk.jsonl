{"send": {"id": 9, "op": "snippet_query", "text": ";sig", "limit": 1}}
{"recv": {"id": 9, "ok": true, "rows": [{"id": 1, "name": "Email signature", "keyword": ";sig", "body": "Best,\nSaurabh", "tags": [], "created": "*", "last_used": 0, "uses": 0}]}}
