{"send": {"id": 6, "op": "timer_parse", "text": "pizza"}}
{"recv": {"id": 6, "ok": true, "spec": null}}
{"send": {"id": 7, "op": "timer_list"}}
{"recv": {"id": 7, "ok": true, "timers": [{"id": 1, "label": "Tea", "total": 1500, "state": "running", "ends_at": "*", "left": "*", "created": "*"}, {"id": 2, "label": "Stretch", "total": 600, "state": "paused", "left": "*", "created": "*"}]}}
{"send": {"id": 8, "op": "timer_cancel", "timer_id": 2}}
